# PriceScan deployment example
# Copy to .env on the server and fill real values when needed.

DATA_DIR=/app/data
DATABASE_PATH=/app/data/pricescan.db

# Per-source daily external request safety limits (Asia/Seoul reset)
NAVER_DAILY_REQUEST_LIMIT=200
DANAWA_DAILY_REQUEST_LIMIT=100
ENURI_DAILY_REQUEST_LIMIT=60
COUPANG_DAILY_REQUEST_LIMIT=60

# Chrome Web Store 미공개 등록 후 발급되는 PriceScan Collector 설치 URL
# 프론트엔드 배포 환경에도 같은 값이 필요합니다.
VITE_PRICESCAN_EXTENSION_URL=https://chromewebstore.google.com/detail/...

# Optional DeepSeek chat. Server-only; leave blank to disable external AI calls.
# Choose a chat-completions model available in your DeepSeek account.
PRICESCAN_AI_API_KEY=
PRICESCAN_AI_MODEL=
