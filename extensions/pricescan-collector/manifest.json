{
  "manifest_version": 3,
  "name": "PriceScan Collector",
  "description": "사용자가 보는 쇼핑몰 검색/상세 화면에서 가격 비교 정보를 수집해 PriceScan으로 보냅니다.",
  "version": "0.1.4",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PriceScan Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8300/*",
    "http://127.0.0.1:8400/*",
    "http://127.0.0.1:8401/*",
    "http://localhost:8300/*",
    "http://localhost:8400/*",
    "http://localhost:8401/*",
    "https://pricescan.d2blue.com/*",
    "https://shopping.naver.com/*",
    "https://search.shopping.naver.com/*",
    "https://www.danawa.com/*",
    "https://search.danawa.com/*",
    "https://www.enuri.com/*",
    "https://www.coupang.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8300/*",
        "http://localhost:8300/*",
        "https://pricescan.d2blue.com/*"
      ],
      "js": [
        "pricescan-page.js"
      ],
      "run_at": "document_start"
    }
  ]
}
