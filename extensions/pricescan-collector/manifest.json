{
  "manifest_version": 3,
  "name": "PriceScan Collector",
  "description": "사용자가 직접 연 네이버 쇼핑 화면에서 현재 보이는 상품 가격을 한 번만 PriceScan으로 가져옵니다.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PriceScan Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "extension-runtime.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8300/*",
    "http://127.0.0.1:8400/*",
    "http://127.0.0.1:8401/*",
    "http://localhost:8300/*",
    "http://localhost:8400/*",
    "http://localhost:8401/*",
    "https://pricescan.d2blue.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8300/*",
        "http://localhost:8300/*",
        "https://pricescan.d2blue.com/*"
      ],
      "js": [
        "pricescan-page.js"
      ],
      "run_at": "document_start"
    }
  ]
}
