{
  "manifest_version": 3,
  "name": "PriceScan Collector",
  "description": "검색 한 번으로 사전 로그인된 네 쇼핑몰의 보이는 최저가 후보를 AI 감독형 흐름으로 조사합니다.",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "side_panel": { "default_path": "approval-panel.html" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PriceScan Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "extension-runtime.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://shopping.naver.com/*", "https://search.shopping.naver.com/*", "https://smartstore.naver.com/*", "https://brand.naver.com/*",
    "https://search.danawa.com/*", "https://prod.danawa.com/*",
    "https://www.enuri.com/*", "https://enuri.com/*", "https://www.coupang.com/*"
  ],
  "host_permissions": [
    "https://pricescan.d2blue.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pricescan.d2blue.com/*"
      ],
      "js": [
        "pricescan-page.js"
      ],
      "run_at": "document_start"
    }
  ]
}
